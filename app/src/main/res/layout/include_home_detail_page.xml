<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 상세페이지 전용 오버레이 -->
    <LinearLayout
        android:id="@+id/detail_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="120dp"
        android:background="@drawable/bg_detail_top_round"
        android:elevation="18dp"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="42dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#D8D8D8" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingTop="8dp"
            android:paddingEnd="22dp"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/tv_detail_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="12dp"
                android:layout_toStartOf="@id/btn_detail_close"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#222222"
                android:textSize="24sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_detail_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="✕"
                android:textAllCaps="false"
                android:textColor="#666666"
                android:textSize="24sp"
                android:textStyle="bold"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="22dp"
                app:elevation="0dp"
                app:iconPadding="0dp"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_write_place_post"
                android:layout_width="250dp"
                android:layout_height="52dp"
                android:layout_below="@id/tv_detail_title"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="26dp"
                android:text="✎  이 장소로 글쓰기"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="#F19E39"
                app:cornerRadius="26dp"
                app:elevation="0dp"
                app:iconPadding="0dp" />

        </RelativeLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            app:tabIndicatorColor="#F19E39"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed"
            app:tabRippleColor="@android:color/transparent"
            app:tabSelectedTextColor="#F19E39"
            app:tabTextColor="#777777">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="홈" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="메뉴" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="사진" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="리뷰1" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="리뷰2" />

        </com.google.android.material.tabs.TabLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E6E6E6" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F7F5F2">

            <!-- 홈 -->
            <LinearLayout
                android:id="@+id/tab_home"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F7F5F2"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="24dp"
                android:paddingEnd="28dp"
                android:paddingBottom="24dp"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_close_circle"
                        android:gravity="center"
                        android:text="open"
                        android:textColor="#F19E39"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_home_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:textColor="#222222"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_close_circle"
                        android:gravity="center"
                        android:text="⌖"
                        android:textColor="#666666"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/tv_home_address"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#333333"
                        android:textSize="16sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_close_circle"
                        android:gravity="center"
                        android:text="☎"
                        android:textColor="#666666"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/tv_home_phone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:textColor="#333333"
                        android:textSize="17sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#F7F5F2" />

            </LinearLayout>

            <!-- 메뉴 -->
            <LinearLayout
                android:id="@+id/tab_menu"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F7F5F2"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_menu_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="32dp"
                            android:text="메뉴정보없음"
                            android:textColor="#999999"
                            android:textSize="16sp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/ll_menu_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                </ScrollView>

            </LinearLayout>

            <!-- 사진 -->
            <LinearLayout
                android:id="@+id/tab_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F7F5F2"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_photo_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="32dp"
                            android:text="사진 없음"
                            android:textColor="#999999"
                            android:textSize="16sp"
                            android:visibility="gone" />

                        <GridLayout
                            android:id="@+id/gl_photo_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="3" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_load_more_photo"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:text="더보기"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:visibility="gone"
                            app:backgroundTint="#F19E39"
                            app:cornerRadius="24dp"
                            app:elevation="0dp" />

                    </LinearLayout>

                </ScrollView>

            </LinearLayout>

            <!-- 리뷰1 -->
            <LinearLayout
                android:id="@+id/tab_review1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F7F5F2"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_review_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="32dp"
                            android:text="리뷰 없음"
                            android:textColor="#999999"
                            android:textSize="16sp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/ll_review_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                </ScrollView>

            </LinearLayout>

            <!-- 리뷰2 -->
            <LinearLayout
                android:id="@+id/tab_review2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F7F5F2"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="리뷰2 탭 내용"
                    android:textColor="#777777"
                    android:textSize="20sp" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- 상세 로딩 전용 오버레이 -->
    <FrameLayout
        android:id="@+id/view_detail_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="120dp"
        android:background="@drawable/bg_detail_top_round"
        android:elevation="19dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="로딩중"
            android:textColor="#444444"
            android:textSize="18sp" />

    </FrameLayout>

</merge>