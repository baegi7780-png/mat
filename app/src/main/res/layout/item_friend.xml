<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="145dp"
    android:orientation="horizontal"
    android:padding="14dp"
    android:background="@drawable/bg_card_round"
    android:layout_marginBottom="10dp">

    <ImageView
        android:id="@+id/ivProfile"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_gravity="center_vertical"
        android:src="@drawable/default_profile"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_profile_circle" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvNickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="닉네임"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="추천 친구"
            android:textSize="13sp"
            android:textColor="#FF8A00" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnChat"
            android:layout_width="88dp"
            android:layout_height="34dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_chat_outline_round"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="1:1채팅"
            android:textColor="#A45A2A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnInvite"
            android:layout_width="88dp"
            android:layout_height="34dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_orange_fill_round"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="모임초대"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDeleteFriend"
            android:layout_width="88dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_red_round"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="친구삭제"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>