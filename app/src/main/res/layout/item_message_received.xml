<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="7dp"
    android:paddingEnd="4dp"
    android:paddingBottom="7dp">

    <ImageView
        android:id="@+id/iv_profile"
        android:layout_width="43dp"
        android:layout_height="43dp"
        android:background="@drawable/ic_profile_placeholder"
        android:src="@drawable/default_profile"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        android:outlineProvider="background"
        android:elevation="2dp"
        android:padding="1dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_sender_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="상대방"
            android:textColor="#2B241D"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_message_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:autoLink="web"
                    android:linksClickable="true"
                    android:background="@drawable/bg_bubble_received"
                    android:minWidth="52dp"
                    android:maxWidth="310dp"
                    android:paddingStart="15dp"
                    android:paddingTop="11dp"
                    android:paddingEnd="15dp"
                    android:paddingBottom="11dp"
                    android:text="상대가 보낸 메시지"
                    android:textColor="#241C14"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    android:breakStrategy="high_quality"
                    android:hyphenationFrequency="normal" />

                <ImageView
                    android:id="@+id/iv_message_image"
                    android:layout_width="226dp"
                    android:layout_height="226dp"
                    android:minWidth="160dp"
                    android:minHeight="160dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_bubble_received"
                    android:clipToOutline="true"
                    android:outlineProvider="background"
                    android:scaleType="centerCrop"
                    android:elevation="2dp"
                    android:visibility="gone" />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="6dp">

                <TextView
                    android:id="@+id/tv_unread_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="14dp"
                    android:minHeight="14dp"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#FF7A1A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="오후 7:07"
                    android:textColor="#9B8875"
                    android:textSize="10sp"
                    app:layout_constraintTop_toBottomOf="@id/tv_unread_count"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>